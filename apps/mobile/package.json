{
  "name": "spir-games-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/baloo-bhaijaan-2": "^0.4.2",
    "@expo-google-fonts/lalezar": "^0.4.1",
    "@expo-google-fonts/readex-pro": "^0.4.1",
    "@expo-google-fonts/reem-kufi": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "^58.0.26",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linking": "^58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "^58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "^58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "phaser": "^3.90.0",
    "pixi.js": "^8.22.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit && node node_modules/typescript-7/bin/tsc -p ../../games/tsconfig.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test src/lib/*.test.mts ../../games/*/*.test.mts",
    "build:web": "npm run build:games && expo export --platform web --clear && node scripts/pwa.mjs && node scripts/packs-web.mjs",
    "lint": "eslint . --max-warnings=0",
    "build:games": "node scripts/build-games.mjs",
    "levels:drop-cat": "node --disable-warning=ExperimentalWarning ../../games/drop-cat/generate.mts",
    "pretypecheck": "npm run build:games",
    "pretest": "npm run build:games",
    "prestart": "npm run build:games",
    "preweb": "npm run build:games",
    "preandroid": "npm run build:games",
    "pack:godot": "node scripts/godot-pack.mjs"
  },
  "private": true,
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  },
  "engines": {
    "node": ">=22.18"
  }
}
