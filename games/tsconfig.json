{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "../apps/mobile/node_modules/@types"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "*": [
        "../apps/mobile/node_modules/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "../packages/**/*.ts"
  ]
}
