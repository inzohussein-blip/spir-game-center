; «برج سبير» — مشروع Godot 4.4 (فيزياء 2D)
config_version=5

[application]

config/name="برج سبير"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.384, 0.776, 1, 1)

[audio]

driver/driver="Dummy"

[autoload]

Spir="*res://addons/spir/spir.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_clear_color=Color(0.384, 0.776, 1, 1)

[physics]

2d/solver/solver_iterations=24
common/physics_ticks_per_second=120
